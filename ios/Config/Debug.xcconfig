// Debug builds (simulator or a phone) talk to the deployed backend so no
// local server is needed. For local development against `npm run dev`,
// change this to http:/$()/localhost:5000 (simulator) or your Mac's LAN
// address, e.g. http:/$()/192.168.1.20:5000 (phone on the same Wi-Fi).
API_BASE_URL = https:/$()/tastetrace-app.up.railway.app
