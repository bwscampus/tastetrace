# Copy to .env for local development.

ENVIRONMENT=development
APP_NAME=app
SECRET_KEY=dev-insecure-change-me

# Local Postgres. Railway injects DATABASE_URL automatically in production;
# the `postgresql://` scheme it provides is coerced to asyncpg in config.py.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/app

# Where the app is reachable. Used to build password-reset links.
PUBLIC_BASE_URL=http://localhost:8000

# Comma-separated. Leave empty when the frontend is same-origin (it usually is).
ALLOWED_ORIGINS=
ALLOWED_HOSTS=*

# Resend. Reset emails only reach arbitrary inboxes from a verified domain;
# the onboarding@resend.dev sender delivers ONLY to the Resend account owner.
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev

# Optional. Without it the Food Suspect Digest still writes a summary, from a
# template rather than a model, and reading a meal photo reports itself
# unavailable so the app tells people to type the meal in instead.
ANTHROPIC_API_KEY=

# Reading a meal photo. Defaults shown; uncomment only to change one.
# PHOTO_RECOGNITION_ENABLED=true   # off by default; see PRIV-1 in docs/SECURITY-GAPS.md
# PHOTO_MODEL=claude-opus-5-5
# PHOTO_TIMEOUT_SECONDS=20
# PHOTO_RATE_LIMIT_SECONDS=10
# PHOTO_DAILY_LIMIT=40
# MAX_PHOTO_BYTES=4194304
# RATE_LIMIT_MEAL_PHOTO=20/hour
