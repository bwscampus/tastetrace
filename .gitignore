# ── Secrets and local config ────────────────────────────────────────────────
# Never commit credentials: DATABASE_URL, SESSION_SECRET, ANTHROPIC_API_KEY…
.env
.env.*
!.env.example
*.pem
*.key

# ── Dependencies ────────────────────────────────────────────────────────────
node_modules/
.npm/
.pnpm-store/

# ── Build output ────────────────────────────────────────────────────────────
dist/
build/
*.tsbuildinfo

# ── Swift / Xcode (ios/) ────────────────────────────────────────────────────
*.xcodeproj/
*.xcworkspace/
!*.xcodeproj/project.pbxproj.example
# ios/TasteTrace.xcworkspace is hand-written, not generated: it is what you
# open in Xcode, and it references the .xcodeproj alongside the four local
# packages.
!ios/TasteTrace.xcworkspace/
# ios/TasteTrace.xcodeproj IS generated, from ios/project.yml, but it is
# committed anyway so a clone can open the workspace without installing
# XcodeGen. project.yml stays the source of truth: change the spec, run
# `xcodegen generate`, and commit both together.
!ios/TasteTrace.xcodeproj/
# Everything per-user inside it stays out: the xcuserdata/ rule below covers
# the window state and scheme ordering, and *.xcworkspace/ above keeps the
# nested project.xcworkspace out (Xcode recreates it on open).
xcuserdata/
DerivedData/
*.xcresult
.build/
.swiftpm/
Package.resolved

# ── Tooling caches ──────────────────────────────────────────────────────────
.vercel/
.turbo/
.vite/
coverage/
*.log
npm-debug.log*
yarn-error.log*

# ── Editors ─────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*~

# ── macOS ───────────────────────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride
Icon?
._*
.Spotlight-V100
.Trashes
