# ── Secrets and local config ────────────────────────────────────────────────
# Never commit credentials: DATABASE_URL, SESSION_SECRET, ANTHROPIC_API_KEY…
.env
.env.*
!.env.example
*.pem
*.key

# ── Dependencies ────────────────────────────────────────────────────────────
node_modules/
.npm/
.pnpm-store/

# ── Build output ────────────────────────────────────────────────────────────
dist/
build/
*.tsbuildinfo

# ── Swift / Xcode (ios/) ────────────────────────────────────────────────────
# The Xcode project is generated from ios/project.yml with `xcodegen generate`
*.xcodeproj/
*.xcworkspace/
!*.xcodeproj/project.pbxproj.example
# ios/TasteTrace.xcworkspace is hand-written, not generated: it is what you
# open in Xcode, and it references the generated .xcodeproj alongside the four
# local packages.
!ios/TasteTrace.xcworkspace/
xcuserdata/
DerivedData/
*.xcresult
.build/
.swiftpm/
Package.resolved

# ── Tooling caches ──────────────────────────────────────────────────────────
.vercel/
.turbo/
.vite/
coverage/
*.log
npm-debug.log*
yarn-error.log*

# ── Editors ─────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*~

# ── macOS ───────────────────────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride
Icon?
._*
.Spotlight-V100
.Trashes
